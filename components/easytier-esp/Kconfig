menu "EasyTier-ESP"

    choice EASYTIER_ESP_LOG_LEVEL
        prompt "组件日志等级"
        default EASYTIER_ESP_LOG_INFO
        help
            选择编译进固件的最高日志等级。低于所选等级的日志语句会在编译期被
            完全裁剪（无运行期开销，也不占固件体积）；Closed 表示关闭组件全部
            日志。ESP-IDF 的全局日志等级仍会叠加生效。

        config EASYTIER_ESP_LOG_CLOSED
            bool "Closed（关闭全部日志）"

        config EASYTIER_ESP_LOG_ERROR
            bool "Error（仅错误）"

        config EASYTIER_ESP_LOG_WARNING
            bool "Warning（错误与警告）"

        config EASYTIER_ESP_LOG_INFO
            bool "Info（默认）"

        config EASYTIER_ESP_LOG_DEBUG
            bool "Debug（全部日志）"
    endchoice

    config EASYTIER_ESP_MAX_CONNECTED_PEERS
        int "同时连接的入口节点数上限"
        range 1 8
        default 6
        help
            配置里可以写任意多个入口地址，此选项只限制同一时刻最多建立多少条
            TCP 连接；超出部分的入口作为轮换备用，连接失败时按退避轮换使用。
            每个连接槽约占 12 KiB 堆内存（收发缓冲），请结合可用内存调整。

    config EASYTIER_ESP_RPC_MAX_TRANSACTIONS
        int "并发 RPC 事务数上限"
        range 1 16
        default 4

    config EASYTIER_ESP_RPC_REASSEMBLY_SLOTS
        int "RPC 分片重组槽数量"
        range 1 8
        default 2

    menu "任务栈与优先级"

        config EASYTIER_ESP_IO_TASK_STACK
            int "I/O 任务栈（字节）"
            range 2048 32768
            default 6144
            help
                et_io 任务栈。它要容纳 select/切帧路径上的少量局部变量（大缓冲都在
                Context 里），余量主要留给 FreeRTOS 上下文切换与日志调用。
                每个实例各有一份。

        config EASYTIER_ESP_PROTO_TASK_STACK
            int "控制面任务栈（字节）"
            range 4096 65536
            default 10240
            help
                et_proto 任务栈。控制面里最大的栈帧是握手/路由同步主循环（约 4.6 KiB），
                该默认值留有约 2 倍余量；改小前请先跑 tools/check_stack_usage.py。

        config EASYTIER_ESP_DATA_TASK_STACK
            int "数据面任务栈（字节）"
            range 2048 32768
            default 8192
            help
                et_data 任务栈。转发路径最坏链约 4.3 KiB，默认值留有余量。
                每个实例各有一份。

        config EASYTIER_ESP_IO_TASK_PRIORITY
            int "I/O 任务优先级"
            range 1 24
            default 7
            help
                et_io 任务优先级。必须低于 WiFi 与 TCPIP 任务（ESP-IDF 默认约 23 / 18），
                否则网络栈会被饿死；上限 24 来自 FreeRTOS configMAX_PRIORITIES=25。

        config EASYTIER_ESP_PROTO_TASK_PRIORITY
            int "控制面任务优先级"
            range 1 24
            default 5
            help
                et_proto 任务优先级。默认低于 I/O 任务，避免控制面抢占收发。

        config EASYTIER_ESP_DATA_TASK_PRIORITY
            int "数据面任务优先级"
            range 1 24
            default 7
            help
                et_data 任务优先级。默认与 I/O 任务同级；同样应低于 WiFi/TCPIP。

    endmenu

    menu "队列深度"

        config EASYTIER_ESP_QUEUE_RX_CTRL_DEPTH
            int "控制面接收队列 q_rx_ctrl"
            range 1 32
            default 8
            help
                I/O 任务 → 控制面的帧队列。每个元素是一个 FrameMessage（约 2 KiB），
                因此常驻堆内存 ≈ 深度 × 2 KiB；队列满时控制面会丢帧并计入 dropped。
                旧默认 4 在突发路由同步/RPC 下容易溢出，现默认 8。

        config EASYTIER_ESP_QUEUE_TX_DEPTH
            int "发送队列 q_tx"
            range 1 32
            default 8
            help
                控制面 / 数据面 → I/O 任务的发送队列。TCP 写入跟不上时帧会在此积压，
                队列满即丢帧；每个元素约 2 KiB。旧默认 4，现默认 8。

        config EASYTIER_ESP_QUEUE_RX_DATA_DEPTH
            int "数据面接收队列 q_rx_data"
            range 1 32
            default 8
            help
                I/O 任务 → 数据面的 Data 帧队列。每个元素约 2 KiB；旧默认 4，现默认 8。

        config EASYTIER_ESP_QUEUE_SMALL_DEPTH
            int "事件/命令队列 q_evt / q_io_cmd / q_app_cmd"
            range 1 32
            default 8
            help
                三个小消息队列（连接事件、重连命令、物理网络状态）共用的深度，元素是
                SmallMessage（约 8 B）。深度过小会让 underlay 状态或重连命令入队失败。

        config EASYTIER_ESP_QUEUE_NETIF_DEPTH
            int "虚拟网卡出站队列 q_netif_rx"
            range 1 64
            default 16
            help
                TCPIP 线程 → 数据面的 pbuf 队列，元素是 NetifRxItem（约 8 B，持有 pbuf
                引用）。深度过小时 TCPIP 线程的零等待入队会失败并按丢包处理。

        # 注意：q_snapshot（控制面 → 数据面的路由快照）按设计固定深度 1——
        # 它是"只保留最新快照"的覆盖语义，不提供 Kconfig 选项。

    endmenu

endmenu
